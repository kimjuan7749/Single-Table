generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. 회원 정보
model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String
  createdAt DateTime   @default(now())
  userTools UserTool[]
  carts     Cart[]
}

// 2. 조리 기구 정보
model CookingTool {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  userTools    UserTool[]
  productTools ProductTool[]
}

// 3. 회원 보유 조리 기구 매핑
model UserTool {
  id            Int         @id @default(autoincrement())
  userId        Int
  cookingToolId Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookingTool   CookingTool @relation(fields: [cookingToolId], references: [id], onDelete: Cascade)
}

// 4. 소용량 상품 정보
model Product {
  id           Int           @id @default(autoincrement())
  name         String
  price        Int
  category     String
  imageUrl     String?
  createdAt    DateTime      @default(now())
  productTools ProductTool[]
  carts        Cart[]
  recipeItems  RecipeItem[]  // 👈 누락되었던 관계 필드 추가됨
}

// 5. 상품 조리에 필요한 조리 기구 매핑
model ProductTool {
  id            Int         @id @default(autoincrement())
  productId     Int
  cookingToolId Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cookingTool   CookingTool @relation(fields: [cookingToolId], references: [id], onDelete: Cascade)
}

// 6. 장바구니
model Cart {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int     @default(1)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 7. 레시피 정보
model Recipe {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  items       RecipeItem[]
}

// 8. 레시피 - 상품 매핑
model RecipeItem {
  id        Int     @id @default(autoincrement())
  recipeId  Int
  productId Int
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}